{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/download/scanner",
      "dest": "/public/RetroAC_Scanner.exe",
      "headers": {
        "Content-Disposition": "attachment; filename=\"RetroAC_Scanner.exe\""
      }
    },
    {
      "src": "/api/download/scanner",
      "dest": "/public/RetroAC_Scanner.exe",
      "headers": {
        "Content-Disposition": "attachment; filename=\"RetroAC_Scanner.exe\""
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1",
      "headers": {
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "X-XSS-Protection": "1; mode=block"
      }
    }
  ]
}
